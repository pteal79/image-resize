{
    "name": "pteal79/image-resize",
    "description": "NativePHP Mobile v4 plugin that shrinks a JPEG, PNG or HEIC photo to a maximum long edge and saves it as a JPEG",
    "type": "nativephp-plugin",
    "license": "MIT",
    "keywords": [
        "nativephp",
        "mobile",
        "image",
        "resize",
        "jpeg",
        "heic",
        "laravel"
    ],
    "require": {
        "php": "^8.4",
        "nativephp/mobile": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Pteal79\\ImageResize\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pteal79\\ImageResize\\ImageResizeServiceProvider"
            ],
            "aliases": {
                "ImageResize": "Pteal79\\ImageResize\\Facades\\ImageResize"
            }
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
